# Copy to .env and fill in. Defaults let the app run immediately on SQLite.

# --- Database ---
# Leave as-is for local dev (SQLite file). For Postgres, use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/garg
DATABASE_URL=sqlite:///./garg.db

# --- Auth / JWT ---
# Generate a real one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- CORS: where the Next.js frontend runs ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Owner account seeded on first run ---
OWNER_EMAIL=owner@gargjewellers.in
OWNER_PASSWORD=change-me-owner

# --- Image storage: Cloudinary (leave blank for local disk) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI background removal needs ~1GB RAM. Set false on small/free hosts.
ENABLE_BG_REMOVAL=true

# --- Razorpay (leave blank until you have keys; checkout runs in mock mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Contact seller ---
WHATSAPP_NUMBER=919999999999

# --- Notifications (all blank => log-only mode; app still works) ---
STORE_NAME=Garg Jewellers

# Email (SMTP). Leave blank to log instead of send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=orders@gargjewellers.in

# SMS via MSG91 (India)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=GARGJW

# WhatsApp via Meta Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
